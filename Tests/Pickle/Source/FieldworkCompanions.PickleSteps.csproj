<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Step definitions for the Pickle suite in ../Mod/Pickle/Features. Only Pickle loads this
    assembly: it lives in the companion test mod, never in the Mod/ folder that goes to the
    Workshop. Mirrors BillAutopilot/Tests/Pickle/Source and SkillIcons/Tests/Pickle/Source.

    Nothing here reaches into Fieldwork Companions by reflection except where the mod itself keeps
    a member private (the settings window's scroll position). Everything else is the mod's public
    surface, bound against the shipped assembly: a step that names something the mod has since
    renamed fails at build rather than in the middle of a WSL run.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>FieldworkCompanions.PickleSteps</AssemblyName>
    <RootNamespace>FieldworkCompanions.PickleSteps</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <OutputPath>..\Mod\Pickle\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time stubs only: the game, Harmony and the Pickle mod supply the real assemblies. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*-*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Krafs.Publicizer" Version="2.*" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="RimWorks.Pickle.Ref" Version="4.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The milk cow's fullness is a protected field of CompHasGatherableBodyResource, and a
         scenario has to fill the udder without waiting a game day. Publicised here so that a
         rename in the game breaks this build, not a run. -->
    <Publicize Include="Assembly-CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bound by name at run time: RimWorld loads Fieldwork Companions before Pickle loads this
         assembly. The shipped assembly is referenced, not a copy. -->
    <Reference Include="FieldworkCompanions">
      <HintPath>..\..\..\Mod\Assemblies\FieldworkCompanions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
